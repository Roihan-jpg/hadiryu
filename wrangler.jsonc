{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "absensi-guru",
  "compatibility_date": "2026-09-03",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./apps/web/dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
