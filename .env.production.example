# Runtime aplikasi. Salin ke secret manager/deployment environment; jangan commit nilainya.
NODE_ENV=production
API_PORT=3000
SUPABASE_URL=https://jlqzeytwwdnooepagknb.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
SUPABASE_SECRET_KEY=replace-with-project-secret-key
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1

# Supabase CLI hosted. Diperlukan hanya saat link/deploy/advisors.
SUPABASE_ACCESS_TOKEN=replace-with-personal-access-token
SUPABASE_DB_PASSWORD=replace-with-database-password

# Bootstrap SuperAdmin. Password awal wajib diganti saat login pertama.
SUPER_ADMIN_NIP=replace-with-super-admin-nip
SUPER_ADMIN_FULL_NAME=Replace With SuperAdmin Name
SUPER_ADMIN_INITIAL_PASSWORD=replace-with-temporary-password

# Akun dan lokasi khusus smoke test hosted; jangan gunakan akun manusia/production.
E2E_ADMIN_PASSWORD=replace-with-changed-admin-password
E2E_TEACHER_NIP=replace-with-dedicated-smoke-teacher-nip
E2E_TEACHER_INITIAL_PASSWORD=replace-with-temporary-teacher-password
E2E_TEACHER_PASSWORD=replace-with-dedicated-smoke-teacher-password
# Pilih tanggal masa depan yang belum memiliki izin aktif untuk akun smoke.
E2E_LEAVE_DATE=2026-09-01
E2E_LATITUDE=-6.200000
E2E_LONGITUDE=106.816666
