# Template referensi saja. Jangan menyalin file ini menjadi .env production dan
# jangan commit nilai sebenarnya. Simpan setiap secret di secret manager provider.

# -----------------------------------------------------------------------------
# Runtime bersama
# -----------------------------------------------------------------------------
# SUPABASE_URL dan SUPABASE_SECRET_KEY wajib untuk Cloudflare Worker maupun
# Express. SUPABASE_PUBLISHABLE_KEY hanya wajib untuk Express, installer, dan
# tool hosted; bundle Angular tidak membaca key Supabase.
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key
SUPABASE_SECRET_KEY=sb_secret_replace_with_project_key

# -----------------------------------------------------------------------------
# Express production saja (diabaikan oleh Cloudflare Worker)
# -----------------------------------------------------------------------------
NODE_ENV=production
API_PORT=3000
SESSION_COOKIE_SECURE=true
# Origin exact tanpa trailing slash; pisahkan beberapa origin dengan koma.
CORS_ALLOWED_ORIGINS=https://app.example.com
# Isi bilangan bulat sesuai jumlah reverse proxy yang benar-benar dipercaya.
# Biarkan kosong bila Express menerima koneksi langsung.
TRUST_PROXY_HOPS=

# -----------------------------------------------------------------------------
# Operasional Supabase CLI saja; jangan diberikan ke runtime aplikasi
# -----------------------------------------------------------------------------
# Diperlukan oleh db:link:hosted, db:deploy:hosted, dan db:advisors:hosted.
# SUPABASE_ACCESS_TOKEN=replace-with-personal-access-token
# SUPABASE_DB_PASSWORD=replace-with-database-password

# -----------------------------------------------------------------------------
# Bootstrap lama saja; instalasi baru harus memakai `npm run setup`
# -----------------------------------------------------------------------------
# Password harus tepat 8 karakter alfanumerik dan memuat huruf besar, huruf
# kecil, serta angka. Hapus variable ini dari environment setelah dipakai.
# SUPER_ADMIN_NIP=replace-with-super-admin-nip
# SUPER_ADMIN_FULL_NAME=Replace With SuperAdmin Name
# SUPER_ADMIN_INITIAL_PASSWORD=Replace1

# -----------------------------------------------------------------------------
# Opsional: smoke test hosted pada project staging/dedicated, bukan production
# -----------------------------------------------------------------------------
# setup:hosted juga membutuhkan SUPER_ADMIN_* di atas. Gunakan akun dan lokasi
# sintetis khusus test; jangan memakai akun manusia atau koordinat sekolah.
# E2E_ADMIN_PASSWORD=Replace2
# E2E_TEACHER_NIP=replace-with-dedicated-smoke-teacher-nip
# E2E_TEACHER_INITIAL_PASSWORD=Replace3
# E2E_TEACHER_PASSWORD=Replace4
# Pilih tanggal masa depan yang belum mempunyai izin aktif untuk akun smoke.
# E2E_LEAVE_DATE=2099-01-15
# E2E_LATITUDE=-6.200000
# E2E_LONGITUDE=106.816666

# -----------------------------------------------------------------------------
# Opsional: setup non-interaktif untuk CI pada database disposable
# -----------------------------------------------------------------------------
# Jangan menyimpan connection string ini di file. Berikan sebagai secret CI dan
# pastikan memakai direct/session pooler port 5432 dengan sslmode=require.
# HADIRYU_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
# HADIRYU_ADMIN_NIP=admin
# HADIRYU_ADMIN_FULL_NAME=Administrator HadirYu
# HADIRYU_DEMO_TEACHER_NIP=guru.demo
# HADIRYU_DEMO_TEACHER_NAME=Guru Demo
# HADIRYU_DEMO_TEACHER_GENDER=FEMALE
