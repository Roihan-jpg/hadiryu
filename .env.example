# Development lokal untuk API Express.
# Cara yang direkomendasikan: jalankan `npm run setup`; installer akan menulis
# tiga variable SUPABASE_* ke .env tanpa menyimpan database connection string.
NODE_ENV=development
API_PORT=3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Cookie lokal boleh non-Secure karena aplikasi dibuka melalui HTTP localhost.
SESSION_COOKIE_SECURE=false
# Daftar origin browser exact, dipisahkan koma. Proxy Angular lokal memakai origin ini.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200
# Kosongkan bila Express tidak berada di belakang reverse proxy tepercaya.
TRUST_PROXY_HOPS=

# Opsional, hanya untuk command maintenance lama berikut; setup baru memakai
# `npm run setup` dan meminta identitas akun secara interaktif.
# npm run bootstrap:super-admin
# SUPER_ADMIN_NIP=replace-with-super-admin-nip
# SUPER_ADMIN_FULL_NAME=Replace With SuperAdmin Name
# SUPER_ADMIN_INITIAL_PASSWORD=Replace1

# npm run prepare:app-accounts
# APP_ACCOUNT_TEACHER_PASSWORD=Replace2
# APP_ACCOUNT_ADMIN_NIP=replace-with-super-admin-nip
# APP_ACCOUNT_ADMIN_FULL_NAME=Replace With SuperAdmin Name
# APP_ACCOUNT_ADMIN_PASSWORD=Replace3

# Opsional untuk fixture UI lokal, bukan untuk data production.
# GURU8_UI_PASSWORD=Replace4

# Opsional untuk override database integration test lokal. Nilai default sudah
# cocok dengan Supabase CLI lokal, sehingga biasanya tidak perlu diaktifkan.
# HADIRYU_LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
