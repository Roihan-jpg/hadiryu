# Local development defaults. Copy this file to .env if overrides are needed.
API_PORT=3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SESSION_COOKIE_SECURE=false

# Required only while running `npm run bootstrap:super-admin`.
SUPER_ADMIN_NIP=your-super-admin-nip
SUPER_ADMIN_FULL_NAME=Your SuperAdmin Name
SUPER_ADMIN_INITIAL_PASSWORD=your-temporary-password
